# ===========================================
# TiCLearn Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# Database - PostgreSQL
# ===========================================
# Run: docker-compose up -d (see docker-compose.yml)
# Or use a hosted PostgreSQL service (Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@localhost:5435/ticlearn?schema=public"

# ===========================================
# Application
# ===========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ===========================================
# AuthenTiCtion - Better Auth
# ===========================================
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Must match NEXT_PUBLIC_APP_URL in production
BETTER_AUTH_URL="http://localhost:3000"

# ===========================================
# OAuth - Google (Optional)
# ===========================================
# Setup Guide: https://console.cloud.google.com/apis/credentials
# 1. Create a new project in Google Cloud Console
# 2. Enable Google OAuth 2.0 API
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
# 5. Add authorized JavaScript origins: http://localhost:3000
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===========================================
# AI - Google Gemini (Primary AI Provider)
# ===========================================
# Get your API key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""

# ===========================================
# Storage - UploadThing (Optional)
# ===========================================
# Setup Guide: https://uploadthing.com/dashboard
# 1. Create a new project in UploadThing dashboard
# 2. Get your API token from settings
UPLOADTHING_TOKEN=""
UPLOADTHING_APP_ID=""

# ===========================================
# Payments - Fapshi (Cameroon Mobile Money)
# ===========================================
# Setup: https://fapshi.com/developer
# 1. Create a merchant account on Fapshi
# 2. Get your API credentials from the dashboard
# 3. Use sandbox for testing: https://sandbox.fapshi.com
FAPSHI_API_USER=""
FAPSHI_API_KEY=""
FAPSHI_BASE_URL="https://sandbox.fapshi.com"  # Use for testing, change to https://fapshi.com for production
# Webhook auth: POST /api/webhooks/fapshi expects Authorization: Bearer <this>
FAPSHI_WEBHOOK_SECRET=""

# ===========================================
# Email - SMTP (Optional)
# ===========================================
# For Gmail: Use App Password
# 1. Enable 2-Step Verification on your Google account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
ADMIN_EMAIL="admin@ticlearn.com"
FROM_EMAIL="TiCLearn <noreply@ticlearn.com>"

# For other SMTP providers (SendGrid, Mailgun, etc.)
# Update SMTP_HOST and SMTP_PORT accordingly

# ===========================================
# Background Jobs - Inngest (Optional)
# ===========================================
# Setup: https://www.inngest.com/
# 1. Create account and new app
# 2. Get Event Key and Signing Key from settings
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ===========================================
# Security - Arcjet (Optional)
# ===========================================
# Setup: https://app.arcjet.com
# 1. Create a new project
# 2. Get your API key from the dashboard
ARCJET_KEY=""

# ===========================================
# Analytics - PostHog (Optional)
# ===========================================
# Setup: https://posthog.com/
# 1. Create a self-hosted or cloud account
# 2. Get your Project API key
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""
