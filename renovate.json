{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "groupName": "better-auth",
      "matchPackageNames": ["better-auth"],
      "automerge": false,
      "schedule": ["after 10pm", "before 5am", "weekend"]
    },
    {
      "groupName": "next",
      "matchPackageNames": ["next", "react", "react-dom"],
      "automerge": false,
      "schedule": ["after 10pm", "before 5am", "weekend"]
    },
    {
      "groupName": "ai-sdk",
      "matchPackageNames": ["ai", "@ai-sdk/*"],
      "automerge": false,
      "schedule": ["after 10pm", "before 5am", "weekend"]
    },
    {
      "groupName": "pdf-parsers",
      "matchPackageNames": [
        "pdf-parse",
        "pdfjs-dist",
        "mammoth",
        "tesseract.js"
      ],
      "automerge": false,
      "schedule": ["after 10pm", "before 5am", "weekend"]
    }
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "schedule": ["after 10pm", "before 5am", "weekend"],
  "timezone": "Africa/Douala",
  "commitMessagePrefix": "chore(deps):",
  "labels": ["dependencies"],
  "reviewers": ["team"]
}
