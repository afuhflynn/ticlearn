// TiCLearn Prisma Schema
// AI-powered study platform for Cameroonian students

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===========================================
// AuthenTiCtion (Better Auth)
// ===========================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Extended fields for TiCLearn
  role          UserRole  @default(USER)
  referredBy    String?   @map("referred_by")
  refApplied    Boolean   @default(false) @map("ref_applied")
  warningSentAt DateTime? @map("warning_sent_at")

  // Credits system
  credits            Int @default(0) @map("credits")
  totalCreditsEarned Int @default(0) @map("total_credits_earned")

  // Active exam profile
  activeProfileId String?      @unique @map("active_profile_id")
  activeProfile   ExamProfile? @relation("UserActiveProfile", fields: [activeProfileId], references: [id], onDelete: SetNull)

  // Relations
  examProfiles           ExamProfile[]           @relation("UserExamProfiles")
  sessions               Session[]
  accounts               Account[]
  notes                  Note[]
  quizzes                Quiz[]
  quizAttempts           QuizAttempt[]
  examSessions           ExamSession[]
  userStats              UserStats[]
  subscriptions          Subscription[]
  ratings                Rating[]
  feedbacks              Feedback[]
  affiliate              Affiliate?
  posts                  Post[]
  comments               Comment[]
  postLikes              PostLike[]
  notifications          Notification[]
  userSettings           UserSettings?
  chatConversations      ChatConversation[]
  chatMessages           ChatMessage[]
  adminInvites           AdminInvite[]           @relation("InvitedBy")
  paper3UserStats        Paper3UserStats[]
  paper3Attempts         Paper3Attempt[]
  paper3MockAttempts     Paper3MockAttempt[]
  paper3QuestionAttempts Paper3QuestionAttempt[]
  creditTransactions     CreditTransaction[]     @relation("UserCredits")
  referralBonuses        ReferralBonus[]         @relation("ReferrerCredits")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ===========================================
// Exam Abstraction Hierarchy
// ===========================================

model ExamLevel {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique
  programs  Program[]
  createdAt DateTime  @default(now())

  @@map("exam_levels")
}

model Program {
  id                  String               @id @default(cuid())
  examLevelId         String               @map("exam_level_id")
  name                String
  code                String               @unique
  components          Component[]
  examProfilePrograms ExamProfileProgram[]
  createdAt           DateTime             @default(now())

  examLevel ExamLevel @relation(fields: [examLevelId], references: [id], onDelete: Cascade)

  @@index([examLevelId])
  @@map("programs")
}

model Component {
  id        String        @id @default(cuid())
  programId String        @map("program_id")
  name      String
  code      String
  type      ComponentType // PAPER | COURSE
  timeLimit Int?

  program         Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  examSessions    ExamSession[]
  examSources     ExamSource[]
  paper3Sources   Paper3Source[]
  paper3Questions Paper3Question[]
  questions       Question[]
  blueprints      ExamBlueprint[]
  topics          Topic[]

  @@unique([programId, code])
  @@index([programId])
  @@map("components")
}

model Topic {
  id          String @id @default(cuid())
  componentId String @map("component_id")
  name        String
  order       Int    @default(0)

  component       Component           @relation(fields: [componentId], references: [id], onDelete: Cascade)
  userBaselines   UserTopicBaseline[]
  knowledgeChunks KnowledgeChunk[]
  questions       Question[]
  performances    TopicPerformance[]

  @@unique([componentId, name])
  @@index([componentId])
  @@map("topics")
}

model UserTopicBaseline {
  id            String   @id @default(cuid())
  examProfileId String   @map("exam_profile_id")
  topicId       String   @map("topic_id")
  confidence    Int      @default(3)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  examProfile ExamProfile @relation(fields: [examProfileId], references: [id], onDelete: Cascade)
  topic       Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([examProfileId, topicId])
  @@index([examProfileId])
  @@map("user_topic_baselines")
}

model TopicPerformance {
  id            String   @id @default(cuid())
  examProfileId String   @map("exam_profile_id")
  topicId       String   @map("topic_id")
  masteryScore  Float    @default(50) @map("mastery_score")
  attempts      Int      @default(0)
  lastUpdated   DateTime @default(now()) @updatedAt @map("last_updated")

  examProfile ExamProfile @relation(fields: [examProfileId], references: [id], onDelete: Cascade)
  topic       Topic       @relation(fields: [topicId], references: [id])

  @@unique([examProfileId, topicId])
  @@index([examProfileId])
  @@map("topic_performances")
}

model KnowledgeChunk {
  id          String   @id @default(cuid())
  topicId     String   @map("topic_id")
  sourceType  String   @map("source_type")
  sourceId    String   @map("source_id")
  title       String
  content     String   @db.Text
  contentType String   @map("content_type")
  createdAt   DateTime @default(now())

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([sourceType])
  @@map("knowledge_chunks")
}

model ExamSource {
  id          String   @id @default(cuid())
  componentId String   @map("component_id")
  year        Int
  sessionName String   @map("session_name")
  createdAt   DateTime @default(now())

  component Component  @relation(fields: [componentId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([componentId, year])
  @@index([componentId])
  @@map("exam_sources")
}

model Question {
  id           String         @id @default(cuid())
  componentId  String         @map("component_id")
  examSourceId String?        @map("exam_source_id")
  topicId      String?        @map("topic_id")
  text         String         @db.Text
  type         QuestionType
  difficulty   Int?           @default(3)
  marks        Int?           @default(1)
  section      String?
  sourceType   QuestionSource
  createdAt    DateTime       @default(now())

  component  Component   @relation(fields: [componentId], references: [id], onDelete: Cascade)
  topic      Topic?      @relation(fields: [topicId], references: [id])
  examSource ExamSource? @relation(fields: [examSourceId], references: [id])

  @@index([componentId])
  @@index([examSourceId])
  @@index([topicId])
  @@map("questions")
}

model ExamBlueprint {
  id          String   @id @default(cuid())
  componentId String   @map("component_id")
  name        String
  description String?
  totalMarks  Int      @map("total_marks")
  durationMin Int      @map("duration_min")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  component Component          @relation(fields: [componentId], references: [id], onDelete: Cascade)
  sections  BlueprintSection[]
  attempts  MockAttempt[]

  @@unique([componentId, name])
  @@index([componentId])
  @@map("exam_blueprints")
}

model BlueprintSection {
  id               String       @id @default(cuid())
  blueprintId      String       @map("blueprint_id")
  name             String
  questionCount    Int          @map("question_count")
  marksPerQuestion Int?         @map("marks_per_question")
  totalMarks       Int          @map("total_marks")
  questionType     QuestionType
  answerRule       String?      @map("answer_rule")
  order            Int          @default(0)

  blueprint ExamBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@index([blueprintId])
  @@map("blueprint_sections")
}

model MockAttempt {
  id            String         @id @default(cuid())
  examProfileId String         @map("exam_profile_id")
  componentId   String         @map("component_id")
  blueprintId   String?        @map("blueprint_id")
  score         Float?
  totalMarks    Int            @map("total_marks")
  sourceMode    MockSourceMode @map("source_mode")
  timeTaken     Int?           @map("time_taken")
  answers       Json?
  results       Json?
  startedAt     DateTime       @default(now()) @map("started_at")
  completedAt   DateTime?      @map("completed_at")
  createdAt     DateTime       @default(now())

  blueprint ExamBlueprint? @relation(fields: [blueprintId], references: [id])

  @@index([examProfileId])
  @@index([componentId])
  @@index([blueprintId])
  @@map("mock_attempts")
}

model ExamProfileProgram {
  id            String   @id @default(cuid())
  examProfileId String   @map("exam_profile_id")
  programId     String   @map("program_id")
  confidence    Int?     @default(3)
  createdAt     DateTime @default(now())

  examProfile ExamProfile @relation(fields: [examProfileId], references: [id], onDelete: Cascade)
  program     Program     @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([examProfileId, programId])
  @@index([examProfileId])
  @@map("exam_profile_programs")
}

model ExamProfile {
  id                  String    @id @default(cuid())
  userId              String    @map("user_id")
  onboardingCompleted Boolean   @default(false) @map("onboarding_completed")
  onboardingStep      Int       @default(0) @map("onboarding_step")
  examYear            Int?      @map("exam_year")
  examDate            DateTime? @map("exam_date")
  isRetaking          Boolean   @default(false) @map("is_retaking")
  studyHoursPerWeek   Int?      @map("study_hours_per_week")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation("UserExamProfiles", fields: [userId], references: [id], onDelete: Cascade)

  activeForUser          User?                   @relation("UserActiveProfile")
  examSessions           ExamSession[]
  quizAttempts           QuizAttempt[]
  paper3Attempts         Paper3Attempt[]
  paper3MockAttempts     Paper3MockAttempt[]
  paper3QuestionAttempts Paper3QuestionAttempt[]
  userStats              UserStats[]
  paper3UserStats        Paper3UserStats[]
  topicBaselines         UserTopicBaseline[]
  topicPerformances      TopicPerformance[]
  programs               ExamProfileProgram[]

  @@index([userId])
  @@map("exam_profiles")
}

enum ComponentType {
  PAPER
}

// ===========================================
// App Models
// ===========================================

model Note {
  id             String     @id @default(cuid())
  userId         String     @map("user_id")
  title          String
  subject        String
  fileUrl        String     @map("file_url")
  uploadthingKey String?    @map("uploadthing_key")
  fileName       String     @map("file_name")
  fileType       FileType   @map("file_type")
  extractedText  String?    @map("extracted_text") @db.Text
  topics         String[]
  keyPoints      String[]   @map("key_points")
  summary        String?    @db.Text
  status         NoteStatus @default(UPLOADING)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizzes        Quiz[]

  @@index([userId])
  @@index([status])
  @@map("notes")
}

model Quiz {
  id            String         @id @default(cuid())
  userId        String         @map("user_id")
  noteId        String?        @map("note_id")
  noteTitle     String         @map("note_title")
  title         String
  questionCount Int            @map("question_count")
  status        QuizStatus     @default(GENERATING)
  isPublic      Boolean        @default(false) @map("is_public")
  timed         Boolean        @default(false)
  timeLimit     Int?           @map("time_limit")
  metadata      Json? // For storing additional info like weak areas source
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  note          Note?          @relation(fields: [noteId], references: [id], onDelete: Cascade)
  questions     QuizQuestion[]
  attempts      QuizAttempt[]

  @@index([userId])
  @@index([isPublic])
  @@index([status])
  @@map("quizzes")
}

model QuizQuestion {
  id             String              @id @default(cuid())
  quizId         String              @map("quiz_id")
  type           QuestionType
  question       String              @db.Text
  options        String[]
  correctAnswer  String              @map("correct_answer") @db.Text
  explanation    String?             @db.Text
  order          Int
  quiz           Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  attemptAnswers QuizAttemptAnswer[]

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id             String              @id @default(cuid())
  userId         String              @map("user_id")
  examProfileId  String?             @map("exam_profile_id")
  quizId         String              @map("quiz_id")
  quizTitle      String              @map("quiz_title")
  noteTitle      String              @map("note_title")
  score          Float
  totalQuestions Int                 @map("total_questions")
  correctAnswers Int                 @map("correct_answers")
  completedAt    DateTime            @default(now()) @map("completed_at")
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  examProfile    ExamProfile?        @relation(fields: [examProfileId], references: [id])
  quiz           Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers        QuizAttemptAnswer[]

  @@index([userId])
  @@index([examProfileId])
  @@index([quizId])
  @@index([completedAt])
  @@map("quiz_attempts")
}

model QuizAttemptAnswer {
  id            String       @id @default(cuid())
  attemptId     String       @map("attempt_id")
  questionId    String       @map("question_id")
  question      String       @db.Text
  userAnswer    String       @map("user_answer") @db.Text
  correctAnswer String       @map("correct_answer") @db.Text
  isCorrect     Boolean      @map("is_correct")
  explanation   String?      @db.Text
  attempt       QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  quizQuestion  QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([questionId])
  @@map("quiz_attempt_answers")
}

model ExamSession {
  id            String       @id @default(cuid())
  userId        String       @map("user_id")
  examProfileId String?      @map("exam_profile_id")
  componentId   String?      @map("component_id")
  subject       ExamSubject
  subjectLabel  String       @map("subject_label")
  mode          ExamMode
  topic         String
  status        ExamStatus   @default(GENERATING)
  score         Float?
  timeLimit     Int          @map("time_limit")
  timeTaken     Int?         @map("time_taken")
  questions     Json
  answers       Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  examProfile   ExamProfile? @relation(fields: [examProfileId], references: [id])
  component     Component?   @relation(fields: [componentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([examProfileId])
  @@index([status])
  @@map("exam_sessions")
}

model UserStats {
  id               String       @id @default(cuid())
  userId           String       @unique @map("user_id")
  examProfileId    String?      @map("exam_profile_id")
  totalPoints      Int          @default(0) @map("total_points")
  currentStreak    Int          @default(0) @map("current_streak")
  longestStreak    Int          @default(0) @map("longest_streak")
  lastActivityDate DateTime?    @map("last_activity_date")
  quizzesTaken     Int          @default(0) @map("quizzes_taken")
  totalChats       Int          @default(0) @map("total_chats")
  avgScore         Float        @default(0) @map("avg_score")
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  examProfile      ExamProfile? @relation(fields: [examProfileId], references: [id], onDelete: SetNull)

  @@index([examProfileId])
  @@index([totalPoints])
  @@map("user_stats")
}

model Subscription {
  id            String             @id @default(cuid())
  userId        String             @unique @map("user_id")
  userEmail     String             @map("user_email")
  userName      String             @map("user_name")
  plan          Plan
  status        SubscriptionStatus @default(PENDING)
  fapshiTransId String?            @unique @map("fapshi_trans_id")
  amount        Int
  activatedAt   DateTime?          @map("activated_at")
  createdAt     DateTime           @default(now())
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([fapshiTransId])
  @@map("subscriptions")
}

model Rating {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  userEmail String   @map("user_email")
  userName  String   @map("user_name")
  score     Int
  comment   String?  @db.Text
  version   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ratings")
}

model Feedback {
  id        String         @id @default(cuid())
  userId    String         @map("user_id")
  userEmail String         @map("user_email")
  userName  String         @map("user_name")
  type      FeedbackType
  subject   String
  message   String         @db.Text
  status    FeedbackStatus @default(OPEN)
  isFlagged Boolean        @default(false) @map("is_flagged")
  isUrgent  Boolean        @default(false) @map("is_urgent")
  adminNote String?        @map("admin_note") @db.Text
  attemptId String?        @map("attempt_id")
  mockId    String?        @map("mock_id")
  rating    Int?           @default(0) @map("rating")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([attemptId])
  @@map("feedbacks")
}

model Affiliate {
  id               String             @id @default(cuid())
  userId           String             @unique @map("user_id")
  userEmail        String             @map("user_email")
  userName         String             @map("user_name")
  code             String             @unique
  status           AffiliateStatus    @default(PENDING)
  momoNumber       String             @map("momo_number")
  momoName         String             @map("momo_name")
  totalClicks      Int                @default(0) @map("total_clicks")
  totalConversions Int                @default(0) @map("total_conversions")
  totalEarnings    Float              @default(0) @map("total_earnings")
  pendingEarnings  Float              @default(0) @map("pending_earnings")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks           AffiliateClick[]
  earnings         AffiliateEarning[]

  @@index([code])
  @@index([status])
  @@map("affiliates")
}

model AffiliateClick {
  id                String    @id @default(cuid())
  affiliateCode     String    @map("affiliate_code")
  affiliateEmail    String    @map("affiliate_email")
  converted         Boolean   @default(false)
  referredUserEmail String?   @map("referred_user_email")
  createdAt         DateTime  @default(now())
  affiliate         Affiliate @relation(fields: [affiliateCode], references: [code])

  @@index([affiliateCode])
  @@map("affiliate_clicks")
}

model AffiliateEarning {
  id                String        @id @default(cuid())
  affiliateCode     String        @map("affiliate_code")
  affiliateEmail    String        @map("affiliate_email")
  referredUserId    String?       @map("referred_user_id")
  referredUserEmail String        @map("referred_user_email")
  plan              Plan
  amount            Int
  commission        Float
  status            EarningStatus @default(PENDING)
  requestedAt       DateTime?     @map("requested_at")
  paidAt            DateTime?     @map("paid_at")
  createdAt         DateTime      @default(now())
  affiliate         Affiliate     @relation(fields: [affiliateCode], references: [code])

  @@index([affiliateCode])
  @@index([status])
  @@map("affiliate_earnings")
}

// ===========================================
// Community / Social
// ===========================================

model Post {
  id             String     @id @default(cuid())
  userId         String     @map("user_id")
  content        String     @db.Text
  subject        String?
  isPinned       Boolean    @default(false) @map("is_pinned")
  isAnnouncement Boolean    @default(false) @map("is_announcement")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments       Comment[]
  likes          PostLike[]

  @@index([userId])
  @@index([createdAt])
  @@map("posts")
}

model Comment {
  id        String    @id @default(cuid())
  postId    String    @map("post_id")
  userId    String    @map("user_id")
  content   String    @db.Text
  parentId  String?   @map("parent_id")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")

  @@index([postId])
  @@index([userId])
  @@map("comments")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

// ===========================================
// Notifications
// ===========================================

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ===========================================
// User Settings
// ===========================================

model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique @map("user_id")
  emailNotifications Boolean  @default(true) @map("email_notifications")
  pushNotifications  Boolean  @default(true) @map("push_notifications")
  darkMode           Boolean  @default(false) @map("dark_mode")
  language           String   @default("en")
  timezone           String   @default("Africa/Douala")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model AdminInvite {
  id        String       @id @default(cuid())
  email     String       @unique
  invitedBy String       @map("invited_by")
  token     String       @unique
  status    InviteStatus @default(PENDING)
  expiresAt DateTime     @map("expires_at")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  inviter User @relation("InvitedBy", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@map("admin_invites")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

