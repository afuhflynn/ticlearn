// TiCLearn Prisma Schema
// AI-powered study platform for Cameroonian students

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===========================================
// AuthenTiCtion (Better Auth)
// ===========================================

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Extended fields for TiCLearn
  role          UserRole  @default(USER)
  referredBy    String?   @map("referred_by")
  refApplied    Boolean   @default(false) @map("ref_applied")
  warningSentAt DateTime? @map("warning_sent_at")

  // Credits system
  credits            Int @default(0) @map("credits")
  totalCreditsEarned Int @default(0) @map("total_credits_earned")

  // Level of study, the one academic fact we hold about a student.
  // Nullable: sign-up creates the user before the level is known, the guards enforce it.
  levelOfStudy String? @map("level_of_study")

  // Onboarding flags, moved here from ExamProfile which is being dropped.
  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  onboardingSkipped   Boolean @default(false) @map("onboarding_skipped")

  // Relations
  sessions             Session[]
  accounts             Account[]
  notes                Note[]
  quizzes              Quiz[]
  quizAttempts         QuizAttempt[]
  userStats            UserStats[]
  subscriptions        Subscription[]
  ratings              Rating[]
  feedbacks            Feedback[]
  affiliate            Affiliate?
  posts                Post[]
  comments             Comment[]
  postLikes            PostLike[]
  notifications        Notification[]
  userSettings         UserSettings?
  chatConversations    ChatConversation[]
  chatMessages         ChatMessage[]
  adminInvites         AdminInvite[]         @relation("InvitedBy")
  creditTransactions   CreditTransaction[]   @relation("UserCredits")
  creditPurchaseOrders CreditPurchaseOrder[]
  referralBonuses      ReferralBonus[]       @relation("ReferrerCredits")
  revisionGuides       RevisionGuide[]       @relation("RevisionGuideAuthor")
  kpiEvents            KpiEvent[]
  engagementLogs       EngagementLog[]
  emailSuppression     EmailSuppression[]
  aiUsageEvents        AiUsageEvent[]        @relation("AiUsageEvents")

  @@index([role, createdAt])
  @@index([referredBy])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ===========================================
// Exam Abstraction Hierarchy
// ===========================================

model Topic {
  id       String @id @default(cuid())
  name     String
  nameSlug String @unique @map("name_slug")
  order    Int    @default(0)

  knowledgeChunks KnowledgeChunk[]
  performances    TopicPerformance[]
  notes           TopicNote[]

  @@map("topics")
}

model TopicNote {
  id        String   @id @default(cuid())
  topicId   String   @map("topic_id")
  noteId    String   @map("note_id")
  createdAt DateTime @default(now()) @map("created_at")

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  note  Note  @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([topicId, noteId])
  @@index([noteId])
  @@map("topic_notes")
}

model TopicPerformance {
  id              String    @id @default(cuid())
  noteId          String    @map("note_id")
  topicId         String    @map("topic_id")
  masteryScore    Float     @default(50) @map("mastery_score")
  totalAttempts   Int       @default(0) @map("total_attempts")
  correctAttempts Int       @default(0) @map("correct_attempts")
  lastPracticedAt DateTime? @map("last_practiced_at")
  lastUpdated     DateTime  @default(now()) @updatedAt @map("last_updated")

  note  Note  @relation(fields: [noteId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([noteId, topicId])
  @@index([noteId])
  @@map("topic_performances")
}

model KnowledgeChunk {
  id          String   @id @default(cuid())
  topicId     String   @map("topic_id")
  sourceType  String   @map("source_type")
  sourceId    String   @map("source_id")
  title       String
  content     String   @db.Text
  contentType String   @map("content_type")
  createdAt   DateTime @default(now())

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([sourceType])
  @@map("knowledge_chunks")
}

/// Admin-defined bundle of Paper 1 & 2 blueprint mocks (e.g. "Term 1 set").

// ===========================================
// App Models
// ===========================================

model Note {
  id                String             @id @default(cuid())
  userId            String             @map("user_id")
  title             String
  fileUrl           String             @map("file_url")
  uploadthingKey    String?            @map("uploadthing_key")
  fileName          String             @map("file_name")
  fileType          FileType           @map("file_type")
  extractedText     String?            @map("extracted_text") @db.Text
  keyPoints         String[]           @map("key_points")
  summary           String?            @db.Text
  status            NoteStatus         @default(UPLOADING)
  processingStage   NoteProcessingStage? @map("processing_stage")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizzes           Quiz[]
  topicNotes        TopicNote[]
  topicPerformances TopicPerformance[]
  chatConversations ChatConversation[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([status])
  @@map("notes")
}

model Quiz {
  id            String         @id @default(cuid())
  userId        String         @map("user_id")
  noteId        String?        @map("note_id")
  noteTitle     String         @map("note_title")
  title         String
  questionCount Int            @map("question_count")
  status        QuizStatus     @default(GENERATING)
  isPublic      Boolean        @default(false) @map("is_public")
  timed         Boolean        @default(false)
  timeLimit     Int?           @map("time_limit")
  metadata      Json? // For storing additional info like weak areas source
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  note          Note?          @relation(fields: [noteId], references: [id], onDelete: Cascade)
  questions     QuizQuestion[]
  attempts      QuizAttempt[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([noteId])
  @@index([isPublic])
  @@index([status])
  @@map("quizzes")
}

model QuizQuestion {
  id             String              @id @default(cuid())
  quizId         String              @map("quiz_id")
  type           QuestionType
  question       String              @db.Text
  options        String[]
  correctAnswer  String              @map("correct_answer") @db.Text
  explanation    String?             @db.Text
  order          Int
  quiz           Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  attemptAnswers QuizAttemptAnswer[]

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id             String              @id @default(cuid())
  userId         String              @map("user_id")
  // Nullable: deleting a note deletes its quizzes, and the attempt history
  // survives that because it snapshots the quiz title and every answer.
  quizId         String?             @map("quiz_id")
  quizTitle      String              @map("quiz_title")
  noteTitle      String              @map("note_title")
  score          Float
  totalQuestions Int                 @map("total_questions")
  correctAnswers Int                 @map("correct_answers")
  completedAt    DateTime            @default(now()) @map("completed_at")
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz           Quiz?               @relation(fields: [quizId], references: [id], onDelete: SetNull)
  answers        QuizAttemptAnswer[]

  @@index([userId])
  @@index([userId, completedAt])
  @@index([quizId])
  @@index([completedAt])
  @@map("quiz_attempts")
}

model QuizAttemptAnswer {
  id            String        @id @default(cuid())
  attemptId     String        @map("attempt_id")
  // Nullable: the question snapshot on this row is the history, so it outlives
  // the question it came from.
  questionId    String?       @map("question_id")
  question      String        @db.Text
  userAnswer    String        @map("user_answer") @db.Text
  correctAnswer String        @map("correct_answer") @db.Text
  isCorrect     Boolean       @map("is_correct")
  explanation   String?       @db.Text
  attempt       QuizAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  quizQuestion  QuizQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([attemptId])
  @@index([questionId])
  @@map("quiz_attempt_answers")
}

model UserStats {
  id               String    @id @default(cuid())
  userId           String    @unique @map("user_id")
  totalPoints      Int       @default(0) @map("total_points")
  currentStreak    Int       @default(0) @map("current_streak")
  longestStreak    Int       @default(0) @map("longest_streak")
  lastActivityDate DateTime? @map("last_activity_date")
  quizzesTaken     Int       @default(0) @map("quizzes_taken")
  totalChats       Int       @default(0) @map("total_chats")
  avgScore         Float     @default(0) @map("avg_score")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([totalPoints])
  @@map("user_stats")
}

model Subscription {
  id            String             @id @default(cuid())
  userId        String             @unique @map("user_id")
  userEmail     String             @map("user_email")
  userName      String             @map("user_name")
  plan          Plan
  status        SubscriptionStatus @default(PENDING)
  fapshiTransId String?            @unique @map("fapshi_trans_id")
  amount        Int
  activatedAt   DateTime?          @map("activated_at")
  createdAt     DateTime           @default(now())
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([status, createdAt])
  @@index([fapshiTransId])
  @@map("subscriptions")
}

model Rating {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  userEmail String   @map("user_email")
  userName  String   @map("user_name")
  score     Int
  comment   String?  @db.Text
  version   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ratings")
}

model Feedback {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  userEmail      String         @map("user_email")
  userName       String         @map("user_name")
  type           FeedbackType
  subject        String
  message        String         @db.Text
  status         FeedbackStatus @default(OPEN)
  isFlagged      Boolean        @default(false) @map("is_flagged")
  isUrgent       Boolean        @default(false) @map("is_urgent")
  adminNote      String?        @map("admin_note") @db.Text
  attemptId      String?        @map("attempt_id")
  mockId         String?        @map("mock_id")
  conversationId String?        @map("conversation_id")
  rating         Int?           @default(0) @map("rating")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([attemptId])
  @@index([conversationId])
  @@map("feedbacks")
}

model Affiliate {
  id               String             @id @default(cuid())
  userId           String             @unique @map("user_id")
  userEmail        String             @map("user_email")
  userName         String             @map("user_name")
  code             String             @unique
  status           AffiliateStatus    @default(PENDING)
  momoNumber       String             @map("momo_number")
  momoName         String             @map("momo_name")
  totalClicks      Int                @default(0) @map("total_clicks")
  totalConversions Int                @default(0) @map("total_conversions")
  totalEarnings    Float              @default(0) @map("total_earnings")
  pendingEarnings  Float              @default(0) @map("pending_earnings")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks           AffiliateClick[]
  earnings         AffiliateEarning[]

  @@index([status])
  @@map("affiliates")
}

model AffiliateClick {
  id                String    @id @default(cuid())
  affiliateCode     String    @map("affiliate_code")
  affiliateEmail    String    @map("affiliate_email")
  converted         Boolean   @default(false)
  referredUserEmail String?   @map("referred_user_email")
  createdAt         DateTime  @default(now())
  affiliate         Affiliate @relation(fields: [affiliateCode], references: [code])

  @@index([affiliateCode])
  @@index([affiliateCode, converted])
  @@map("affiliate_clicks")
}

model AffiliateEarning {
  id                String        @id @default(cuid())
  affiliateCode     String        @map("affiliate_code")
  affiliateEmail    String        @map("affiliate_email")
  referredUserId    String?       @map("referred_user_id")
  referredUserEmail String        @map("referred_user_email")
  plan              Plan
  amount            Int
  commission        Float
  status            EarningStatus @default(PENDING)
  requestedAt       DateTime?     @map("requested_at")
  paidAt            DateTime?     @map("paid_at")
  fapshiTransId     String?       @unique @map("fapshi_trans_id")
  createdAt         DateTime      @default(now())
  affiliate         Affiliate     @relation(fields: [affiliateCode], references: [code])

  @@index([affiliateCode])
  @@index([status])
  @@map("affiliate_earnings")
}

// ===========================================
// Community / Social
// ===========================================

model Post {
  id             String     @id @default(cuid())
  userId         String     @map("user_id")
  content        String     @db.Text
  subject        String?
  isPinned       Boolean    @default(false) @map("is_pinned")
  isAnnouncement Boolean    @default(false) @map("is_announcement")
  likeCount      Int        @default(0) @map("like_count")
  commentCount   Int        @default(0) @map("comment_count")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments       Comment[]
  likes          PostLike[]

  @@index([userId])
  @@index([createdAt])
  @@index([isPinned, createdAt])
  @@index([subject, createdAt])
  @@map("posts")
}

model Comment {
  id        String    @id @default(cuid())
  postId    String    @map("post_id")
  userId    String    @map("user_id")
  content   String    @db.Text
  parentId  String?   @map("parent_id")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")

  @@index([postId])
  @@index([postId, createdAt])
  @@index([userId])
  @@index([parentId, createdAt])
  @@map("comments")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

// ===========================================
// Notifications
// ===========================================

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([isRead])
  @@map("notifications")
}

// ===========================================
// User Settings
// ===========================================

model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique @map("user_id")
  emailNotifications Boolean  @default(false) @map("email_notifications")
  pushNotifications  Boolean  @default(true) @map("push_notifications")
  darkMode           Boolean  @default(false) @map("dark_mode")
  language           String   @default("en")
  timezone           String   @default("Africa/Douala")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model AdminInvite {
  id        String       @id @default(cuid())
  email     String       @unique
  invitedBy String       @map("invited_by")
  token     String       @unique
  status    InviteStatus @default(PENDING)
  expiresAt DateTime     @map("expires_at")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  inviter User @relation("InvitedBy", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@map("admin_invites")
}

model KpiEvent {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  event     String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([event])
  @@index([event, createdAt])
  @@index([createdAt])
  @@map("kpi_events")
}

model DailyMetric {
  id          String   @id @default(cuid())
  date        DateTime
  metric      String
  autoValue   Float?
  manualValue Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, metric])
  @@index([date])
  @@index([metric, date])
  @@map("daily_metrics")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ===========================================
// Enums
// ===========================================

enum UserRole {
  USER
  ADMIN
}

enum FileType {
  PDF
  IMAGE
  WORD
}

enum NoteStatus {
  UPLOADING
  PROCESSING
  READY
  ERROR
}

// The stage the note pipeline is in. The order of the values is the order of
// the stages, so the step count out of the total is the index plus one.
enum NoteProcessingStage {
  EXTRACTING
  SUMMARIZING
  INDEXING
}

enum QuizStatus {
  GENERATING
  READY
  ERROR
}

enum QuestionType {
  MCQ
  OPEN
  STRUCTURED
  PRACTICAL
  ESSAY
}

/// Distinguishes student practice sessions vs admin-only preview sessions on Mock exams (Paper 1 & 2).

enum Plan {
  STARTER
  STANDARD
  PREMIUM
  PRO
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  FAILED
}

enum FeedbackType {
  BUG
  FEATURE
  GENERAL
  EXAM
  CHAT
}

enum FeedbackStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum AffiliateStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum EarningStatus {
  PENDING
  REQUESTED
  PAID
}

enum NotificationType {
  SYSTEM
  QUIZ_COMPLETED
  ACHIEVEMENT
  STREAK
  REFERRAL
  PAYMENT
  COMMENT
  LIKE
}

// ===========================================
// Chat Models
// ===========================================

model ChatConversation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  summary   String?  @db.Text
  // The note this conversation is about. Null for a general chat.
  noteId    String?  @map("note_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  note     Note?         @relation(fields: [noteId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([userId])
  @@index([userId, updatedAt])
  @@index([noteId])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  role           String
  content        String   @db.Text
  parts          Json
  createdAt      DateTime @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([userId])
  @@index([userId, role, createdAt])
  @@map("chat_messages")
}

model PaymentSettings {
  id               String   @id @default(cuid())
  key              String   @unique @default("global") @map("key")
  mtnNumber        String?  @unique @map("mtn_number")
  mtnHolderName    String?  @map("mtn_holder_name")
  orangeNumber     String?  @unique @map("orange_number")
  orangeHolderName String?  @map("orange_holder_name")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("payment_settings")
}

model PlatformSettings {
  id  String @id @default(cuid())
  key String @unique @default("global")

  creditCostQuizGeneration    Int @default(50) @map("credit_cost_quiz_generation")
  creditCostPracticeQuestion  Int @default(5) @map("credit_cost_practice_question")
  creditCostRevisionGuideView Int @default(0) @map("credit_cost_revision_guide_view")
  creditCostRevisionGuideGen  Int @default(0) @map("credit_cost_revision_guide_gen")
  creditCostAiTutorMessage    Int @default(5) @map("credit_cost_ai_tutor_message")
  /// Student mock assembly (blueprint or custom generator).
  enforceCreditsForPractice       Boolean @default(true) @map("enforce_credits_for_practice")
  enforceCreditsForRevisionGuides Boolean @default(false) @map("enforce_credits_for_revision_guides")
  enforceCreditsForAiTutor        Boolean @default(true) @map("enforce_credits_for_ai_tutor")

  /// When true, all four per-area enforce flags below behave as if they were on (OR).
  enforceCreditsAll Boolean @default(false) @map("enforce_credits_all")

  /// Pay-as-you-go: credits granted per 1,000 XAF paid (floor).
  creditsPer1000Xaf    Int @default(50) @map("credits_per_1000_xaf")
  minCreditPurchaseXaf Int @default(100) @map("min_credit_purchase_xaf")
  maxCreditPurchaseXaf Int @default(500000) @map("max_credit_purchase_xaf")

  /// Tier-based credit cost multipliers (applied on top of base costs).
  creditCostMultiplierStarter  Float @default(0.8) @map("credit_cost_multiplier_starter")
  creditCostMultiplierStandard Float @default(0.6) @map("credit_cost_multiplier_standard")
  creditCostMultiplierPremium  Float @default(0.4) @map("credit_cost_multiplier_premium")
  creditCostMultiplierPro      Float @default(0.4) @map("credit_cost_multiplier_pro")

  /// USD to XAF rate used for AI cost math. Copied onto each usage row at write time.
  usdToXafRate  Int     @default(650) @map("usd_to_xaf_rate")
  /// Fusion path gate. Off by default, admin only with cost cap when on.
  aiFusionAllow Boolean @default(false) @map("ai_fusion_allow")

  /// Shared cache gate. When false the cache store reads and writes nothing,
  /// which is the rollback path for spec 0010. A settings row rather than an
  /// environment variable, because an environment change on Vercel still needs
  /// a redeploy to reach a running function.
  sharedCacheEnabled Boolean @default(true) @map("shared_cache_enabled")

  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("platform_settings")
}

// ===========================================
// AI model chain (spec 0003)
// ===========================================

model AiModelHealth {
  id        String    @id @default(cuid())
  modelId   String    @unique @map("model_id")
  status    String    @default("healthy") @map("status")
  failCount Int       @default(0) @map("fail_count")
  trippedAt DateTime? @map("tripped_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("ai_model_health")
}

model AiUsageEvent {
  id               String   @id @default(cuid())
  userId           String?  @map("user_id")
  user             User?    @relation("AiUsageEvents", fields: [userId], references: [id], onDelete: SetNull)
  task             String   @map("task")
  modelId          String   @map("model_id")
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  costUsd          Float    @default(0) @map("cost_usd")
  costXaf          Int      @default(0) @map("cost_xaf")
  usdToXafRate     Int      @default(650) @map("usd_to_xaf_rate")
  latencyMs        Int      @default(0) @map("latency_ms")
  errorCode        String?  @map("error_code")
  firstByteMs      Int?     @map("first_byte_ms")
  cacheHit         Boolean? @map("cache_hit")
  cacheNamespace   String?  @map("cache_namespace")
  keepAliveSent    Boolean? @map("keep_alive_sent")
  coldStart        Boolean? @map("cold_start")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([modelId, createdAt])
  @@index([task, createdAt])
  @@index([createdAt])
  @@map("ai_usage_events")
}

/// The shared cache from spec 0010. Keys are hashes, so no prompt text or user
/// data lands here, and nothing joins to it. Written by lib/cache/ only.
model AppCache {
  key       String   @id
  namespace String   @map("namespace")
  value     Json
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@index([namespace])
  @@map("app_cache")
}

model RevisionGuide {
  id          String   @id @default(cuid())
  title       String
  markdown    String   @db.Text
  published   Boolean  @default(false)
  pdfUrl      String?  @map("pdf_url")
  pdfFileName String?  @map("pdf_file_name")
  createdById String   @map("created_by_id")
  createdBy   User     @relation("RevisionGuideAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([published])
  @@index([createdById])
  @@map("revision_guides")
}

// ===========================================
// Credits System
// ===========================================

model CreditTransaction {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  amount      Int // positive for earning, negative for spending
  type        CreditType
  description String?
  referenceId String?    @map("reference_id") // e.g., quiz attempt ID, practice question ID
  createdAt   DateTime   @default(now()) @map("created_at")

  user User @relation("UserCredits", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("credit_transactions")
}

enum CreditType {
  REFERRAL_BONUS // 500 credits when someone signs up using your code
  QUIZ_GENERATION // Spending credits to generate quizzes
  REVISION_GUIDE // Spending credits on revision guide access/generation
  AI_TUTOR_MESSAGE // Spending credits on TiC tutor messages
  BONUS // Admin or promotional bonuses
  CREDIT_PURCHASE // Credits purchased via Mobile Money (pay-as-you-go)
}

enum CreditPurchaseStatus {
  PENDING
  COMPLETED
  FAILED
}

model CreditPurchaseOrder {
  id              String               @id @default(cuid())
  userId          String               @map("user_id")
  amountXaf       Int                  @map("amount_xaf")
  creditsPromised Int                  @map("credits_promised")
  status          CreditPurchaseStatus @default(PENDING)
  fapshiTransId   String?              @unique @map("fapshi_trans_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("credit_purchase_orders")
}

model ReferralBonus {
  id             String   @id @default(cuid())
  referrerId     String   @map("referrer_id") // User who earned the bonus
  refereeId      String   @map("referee_id") // User who signed up
  creditsAwarded Int      @default(500) @map("credits_awarded")
  createdAt      DateTime @default(now()) @map("created_at")

  referrer User @relation("ReferrerCredits", fields: [referrerId], references: [id], onDelete: Cascade)

  @@unique([referrerId, refereeId]) // One bonus per referral pair
  @@index([referrerId])
  @@index([refereeId])
  @@map("referral_bonuses")
}

model EngagementLog {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  campaign String   @map("campaign")
  period   String   @map("period")
  sentAt   DateTime @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, campaign, period])
  @@index([campaign])
  @@index([campaign, sentAt])
  @@map("engagement_log")
}

model EmailSuppression {
  id             String   @id @default(cuid())
  email          String   @unique @map("email")
  reason         String   @map("reason")
  userId         String?  @map("user_id")
  providerMessageId String? @map("provider_message_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("email_suppression")
}
