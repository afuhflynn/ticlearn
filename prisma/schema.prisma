// ===========================================
// Chat Models
// ===========================================

model ChatConversation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
  @@index([userId, updatedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  role           String
  content        String   @db.Text
  parts          Json
  createdAt      DateTime @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([userId])
  @@map("chat_messages")
}

model PaymentSettings {
  id               String   @id @default(cuid())
  key              String   @unique @default("global") @map("key")
  mtnNumber        String?  @unique @map("mtn_number")
  mtnHolderName    String?  @map("mtn_holder_name")
  orangeNumber     String?  @unique @map("orange_number")
  orangeHolderName String?  @map("orange_holder_name")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("payment_settings")
}

// ===========================================
// GCE Paper 3 Models
// ===========================================

model Paper3Source {
  id              String           @id @default(cuid())
  title           String
  year            Int
  componentId     String?          @map("component_id")
  subject         Paper3Subject
  section         Paper3Section
  category        Paper3Category
  paperType       Paper3PaperType
  sourceType      Paper3SourceType
  fileUrl         String           @map("file_url")
  fileName        String?          @map("file_name")
  uploadthingKey  String?          @map("uploadthing_key")
  extractedText   String?          @map("extracted_text") @db.Text
  contentMarkdown String?          @map("content_markdown") @db.Text
  status          Paper3Status     @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  questions       Paper3Question[]
  component       Component?       @relation(fields: [componentId], references: [id], onDelete: SetNull)

  @@index([year, subject])
  @@index([componentId])
  @@index([status])
  @@map("paper3_sources")
}

model Paper3Question {
  id                    String          @id @default(cuid())
  sourceId              String          @map("source_id")
  componentId           String?         @map("component_id")
  questionNumber        String          @map("question_number")
  taskNumber            String?         @map("task_number")
  subPart               String?         @map("sub_part")
  title                 String
  section               Paper3Section
  skillType             Paper3SkillType
  taskType              Paper3TaskType
  programmingLanguage   Paper3Language? @map("programming_language") // C or PASCAL only
  concepts              String[]
  content               String          @db.Text
  contentMd             String?         @db.Text
  marks                 Int             @default(1)
  expectedAnswer        String          @map("expected_answer") @db.Text
  markingBreakdown      Json?           @map("marking_breakdown")
  explanation           String?         @db.Text
  partialCredit         Boolean         @default(false) @map("partial_credit")
  requireAnswer         Boolean         @default(true) @map("require_answer")
  sourceContentMarkdown String?         @map("source_content_markdown") @db.Text

  // Structured task/sub-question breakdown
  taskItems Json? @map("task_items")

  // Enhanced visual elements for Access, Excel, C arrays
  visualElements Json? @map("visual_elements")

  status          QuestionStatus         @default(PENDING)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  source          Paper3Source           @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  component       Component?             @relation(fields: [componentId], references: [id], onDelete: SetNull)
  mockQuestions   Paper3MockQuestion[]
  attempts        Paper3Attempt[]
  detailedResults Paper3DetailedResult[]

  @@index([sourceId])
  @@index([componentId])
  @@index([section, taskType])
  @@index([status])
  @@map("paper3_questions")
}

model Paper3Mock {
  id            String               @id @default(cuid())
  title         String
  description   String?              @db.Text
  subject       Paper3Subject
  focusCategory Paper3FocusCategory  @default(MIXED) @map("focus_category")
  timeLimit     Int                  @map("time_limit")
  totalMarks    Int                  @map("total_marks")
  createdBy     String               @map("created_by")
  status        MockStatus           @default(DRAFT)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  questions     Paper3MockQuestion[]
  attempts      Paper3MockAttempt[]

  @@index([subject, status])
  @@map("paper3_mocks")
}

model Paper3MockQuestion {
  id         String         @id @default(cuid())
  mockId     String         @map("mock_id")
  questionId String         @map("question_id")
  order      Int
  marks      Int            @default(1)
  mock       Paper3Mock     @relation(fields: [mockId], references: [id], onDelete: Cascade)
  question   Paper3Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([mockId, questionId])
  @@map("paper3_mock_questions")
}

model Paper3MockAttempt {
  id                  String                 @id @default(cuid())
  userId              String                 @map("user_id")
  examProfileId       String?                @map("exam_profile_id")
  mockId              String                 @map("mock_id")
  score               Float
  totalMarks          Int                    @map("total_marks")
  timeTaken           Int?                   @map("time_taken")
  answers             Json
  results             Json
  status              MockAttemptStatus      @default(IN_PROGRESS)
  processingStatus    ProcessingStatus       @default(QUEUED) @map("processing_status")
  correctAnswerViewed Boolean                @default(false) @map("correct_answer_viewed")
  shareId             String?                @unique @map("share_id")
  sharedAt            DateTime?              @map("shared_at")
  startedAt           DateTime               @default(now()) @map("started_at")
  completedAt         DateTime?              @map("completed_at")
  mock                Paper3Mock             @relation(fields: [mockId], references: [id], onDelete: Cascade)
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  examProfile         ExamProfile?           @relation(fields: [examProfileId], references: [id])
  detailedResults     Paper3DetailedResult[]

  @@index([userId])
  @@index([examProfileId])
  @@index([mockId])
  @@index([shareId])
  @@map("paper3_mock_attempts")
}

model Paper3UserStats {
  id                 String   @id @default(cuid())
  userId             String   @unique @map("user_id")
  examProfileId      String?  @map("exam_profile_id")
  questionsAttempted Int      @default(0) @map("questions_attempted")
  questionsCorrect   Int      @default(0) @map("questions_correct")
  mockExamsTaken     Int      @default(0) @map("mock_exams_taken")
  totalPoints        Int      @default(0) @map("total_points")
  avgScore           Float    @default(0) @map("avg_score")
  weakConcepts       String[] @default([]) @map("weak_concepts")
  strongConcepts     String[] @default([]) @map("strong_concepts")
  readinessScore     Float    @default(0) @map("readiness_score")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  examProfile ExamProfile? @relation(fields: [examProfileId], references: [id], onDelete: SetNull)

  @@index([examProfileId])
  @@map("paper3_user_stats")
}

model Paper3QuestionAttempt {
  id            String   @id @default(cuid())
  questionId    String   @map("question_id")
  mockId        String?  @map("mock_id")
  attemptId     String   @map("attempt_id")
  userId        String   @map("user_id")
  examProfileId String?  @map("exam_profile_id")
  userAnswer    String   @map("user_answer") @db.Text
  isCorrect     Boolean  @map("is_correct")
  marksEarned   Int      @map("marks_earned")
  score         Float    @map("score")
  timeAnswered  Int      @default(0) @map("time_answered")
  createdAt     DateTime @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  examProfile ExamProfile? @relation(fields: [examProfileId], references: [id])

  @@index([questionId, score])
  @@index([questionId, userId])
  @@index([examProfileId])
  @@map("paper3_question_attempts")
}

model Paper3DetailedResult {
  id              String   @id @default(cuid())
  attemptId       String   @map("attempt_id")
  questionId      String   @map("question_id")
  userAnswer      String   @map("user_answer") @db.Text
  isCorrect       Boolean  @map("is_correct")
  marksEarned     Int      @map("marks_earned")
  totalMarks      Int      @map("total_marks")
  feedback        String?  @map("feedback") @db.Text
  feedbackMd      String?  @map("feedback_md") @db.Text
  codeExplanation String?  @map("code_explanation") @db.Text
  breakdown       Json?    @map("breakdown")
  partialCredit   Boolean  @default(false) @map("partial_credit")
  createdAt       DateTime @default(now()) @map("created_at")

  attempt  Paper3MockAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Paper3Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([questionId])
  @@map("paper3_detailed_results")
}

model Paper3Attempt {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  examProfileId String?  @map("exam_profile_id")
  questionId    String   @map("question_id")
  userAnswer    String   @map("user_answer") @db.Text
  isCorrect     Boolean  @map("is_correct")
  marksEarned   Int      @map("marks_earned")
  totalMarks    Int      @map("total_marks")
  feedback      String?  @map("feedback") @db.Text
  evaluatedAt   DateTime @default(now()) @map("evaluated_at")

  question    Paper3Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  examProfile ExamProfile?    @relation(fields: [examProfileId], references: [id])

  @@index([userId])
  @@index([examProfileId])
  @@index([questionId])
  @@map("paper3_attempts")
}

