# TiCLearn environment template
# Copy to .env then fill real values. Never commit .env with real secrets.
# How to use: run cp .env.example .env then edit .env locally.
# Legend used below. What explains purpose. Format shows exact shape.
# Needed tells if boot or a feature needs it. Browser tells if it ships to browser.
# Safe tells if you may share it in chat or logs. Get it tells where to create it.
# Single template. example.env was removed because the two files disagreed. Edit this file only.

# =====================================================
# Database and Postgres
# =====================================================
# What: Postgres connection for Prisma CLI plus runtime adapter.
# Format: postgresql://user:pass@host:port/db?schema=public
# Needed: yes, app will not boot without it.
# Browser: no, server only.
# Safe: no, it holds a password.
# Get it, local: run pnpm db:up then use the value below which matches docker compose.
DATABASE_URL="postgresql://ticlearn:ticlearn_password@localhost:5435/ticlearn?schema=public"
# What: pooled URL plus direct URL for hosted Postgres like Neon.
# Format: same shape as DATABASE_URL, direct uses the non pooled host.
# Needed: no, only for hosted split setups. Leave commented for local docker.
# Browser: no, server only.
# Safe: no, each holds a password.
# Get it: Neon dashboard Connect button at https://console.neon.tech/signup
# DATABASE_URL="postgresql://user:password@ep-cool1234-pooler.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://user:password@ep-cool1234.aws.neon.tech/neondb?sslmode=require"
# What: throwaway DB Prisma uses to detect drift when app user cannot create DBs.
# Format: same shape as DATABASE_URL, points at an empty DB you own.
# Needed: no, only when migrate complains about rights.
# Browser: no, server only.
# Safe: no, it holds a password.
# SHADOW_DATABASE_URL="postgresql://user:password@localhost:5435/ticlearn_shadow?schema=public"

# =====================================================
# App origin and auth core
# =====================================================
# What: canonical origin used for auth callbacks, payment redirects, invite links, share links, email buttons, browser API base.
# Format: full URL, no trailing slash. Local uses http, live uses https.
# Needed: yes.
# Browser: yes, ships in browser bundle by design.
# Safe: yes, it is a URL not a secret. Still keep server trust on BETTER_AUTH_TRUSTED_ORIGINS below.
# Get it: your own domain. Local value below is fine.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# What: HMAC key that signs session cookies.
# Format: 32 byte or longer random string.
# Needed: yes, auth refuses to run live without it.
# Browser: no, server only.
# Safe: no, never share.
# Get it: run openssl rand -base64 32 then paste the output.
BETTER_AUTH_SECRET="your-better-auth-secret-here"
# What: base URL auth uses for callbacks. Must match NEXT_PUBLIC_APP_URL live.
# Format: full URL, no trailing slash.
# Needed: no, inferred from requests, but set it live to be explicit.
# Browser: no, server only.
# Safe: yes, it is a URL.
# Get it: same as NEXT_PUBLIC_APP_URL.
BETTER_AUTH_URL="http://localhost:3000"
# What: CSV allow list of origins that may send credentialed auth requests. Overrides the app origin fallback.
# Format: comma separated origins, no spaces needed: https://a.com,https://b.com
# Needed: yes, validated at boot by lib/env.ts.
# Browser: no, server only.
# Safe: yes, origins are public.
# Get it: your domains. Local single origin below is fine.
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
# What: previous secret kept during key rotation so old sessions stay valid.
# Format: comma separated secrets, current first.
# Needed: no, only during rotation.
# Browser: no, server only.
# Safe: no, never share.
# Get it: created by you when you rotate BETTER_AUTH_SECRET.
# BETTER_AUTH_SECRETS=""

# =====================================================
# Google sign in
# =====================================================
# What: OAuth client id for Sign in with Google.
# Format: ends with apps.googleusercontent.com
# Needed: yes if you offer Google sign in, else leave blank and Google button will fail at click time.
# Browser: no, server only, though Google treats the id as public by design.
# Safe: yes to share the id, no for the secret below.
# Get it: https://console.cloud.google.com/apis/credentials then create OAuth client id of type Web application, add redirect <origin>/api/auth/callback/google and origin <origin>.
GOOGLE_CLIENT_ID=""
# What: OAuth client secret exchanged at token endpoint.
# Format: opaque string about 35 chars.
# Needed: yes if you offer Google sign in.
# Browser: no, server only.
# Safe: no, never share.
# Get it: same screen as above.
GOOGLE_CLIENT_SECRET=""

# =====================================================
# AI through OpenRouter
# =====================================================
# What: single key all model calls use. Chat, quiz, exam, grading, Paper 3 all route here.
# Format: OpenRouter key shape, see dashboard after creation.
# Needed: yes, every AI call throws without it.
# Browser: no, server only.
# Safe: no, never share.
# Get it: https://openrouter.ai/keys then create a key. Add credit in OpenRouter dashboard.
OPENROUTER_API_KEY=""
# What: global override of per task model order for lab outages.
# Format: comma separated OpenRouter ids, first is head. See value below.
# Needed: no. Leave set to the pinned chain unless a lab is down.
# Browser: no, server only.
# Safe: yes, ids are public.
# Get it: no signup, ids come from OpenRouter catalog.
AI_CHAIN_ORDER="google/gemini-3.7-flash,openai/gpt-5-nano,deepseek/deepseek-v4.1-flash,anthropic/claude-haiku-5.5,z-ai/glm-4.7-flash,openai/gpt-5-mini,google/gemini-3.8-flash,anthropic/claude-haiku-4.5,openai/gpt-oss-120b,meta-llama/llama-3.3-70b-instruct,mistralai/mistral-medium-3.1,x-ai/grok-4.7"
# What: staging only switch that forces chain head to fail one time per request to prove fallback.
# Format: literal 1 to arm, 0 to disarm.
# Needed: no, staging and test only. Never set live.
# Browser: no, server only.
# Safe: yes.
# Get it: no signup, you set it.
AI_HEAD_FAIL_ONCE="0"
# What: gate for rare deep research path. Off by default, admin only with cost cap when on.
# Format: literal 1 to allow, 0 to keep off.
# Needed: no.
# Browser: no, server only.
# Safe: yes.
# Get it: no signup, you set it.
AI_FUSION_ALLOW="0"
# What: XAF per 1 USD used for AI cost math shown per student.
# Format: whole number.
# Needed: no, defaults to 650 when empty.
# Browser: no, server only.
# Safe: yes.
# Get it: your own rate. Value below matches current default.
USD_TO_XAF_RATE="650"
# What: legacy direct Google key from before the OpenRouter move. No code path reads it today.
# Format: Google key shape, starts with AIza.
# Needed: no. Keep empty unless you re enable a direct Google provider call.
# Browser: no, server only.
# Safe: no, never share.
# Get it: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""
# What: web search key for the AI agent chat tool. Chat still works without it, tool replies it is unavailable.
# Format: Tavily key shape, starts with tvly.
# Needed: no.
# Browser: no, server only.
# Safe: no, never share.
# Get it: https://app.tavily.com then copy key. Guide at https://docs.tavily.com/documentation/quickstart
TAVILY_API_KEY=""
# What: optional Tavily project id to split one key across envs in Tavily logs.
# Format: opaque id.
# Needed: no.
# Browser: no, server only.
# Safe: yes.
# Get it: Tavily dashboard project settings.
# TAVILY_PROJECT=""

# =====================================================
# Email over SMTP
# =====================================================
# What: SMTP host and port. Port also picks TLS mode: 465 means implicit TLS, 587 means STARTTLS.
# Format: host name plus port as digits.
# Needed: yes for any email including OTP sign in which is the primary sign in flow. Without it no mail is sent.
# Browser: no, server only.
# Safe: yes for host and port, no for user and pass below.
# Get it: any SMTP vendor. Gmail needs 2 step verification then an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
# What: SMTP login user, often the mailbox address.
# Format: email or vendor user name.
# Needed: yes for any email.
# Browser: no, server only.
# Safe: no, it identifies your mailbox so keep it private.
# Get it: your SMTP vendor account.
SMTP_USER=""
# What: SMTP password or app password.
# Format: opaque string. Gmail app passwords are 16 chars with spaces stripped.
# Needed: yes for any email.
# Browser: no, server only.
# Safe: no, never share.
# Get it: your SMTP vendor. Never use a normal Gmail password, use an App Password.
SMTP_PASS=""
# What: From header on outbound mail. Falls back to TiCLearn no reply address when empty.
# Format: display form, example TiCLearn <no-reply@yourdomain.com>
# Needed: no, has fallback, but set it live.
# Browser: no, server only.
# Safe: yes.
# Get it: an address on a domain you own.
FROM_EMAIL="TiCLearn <no-reply@yourdomain.com>"
# What: inbox for contact form, feedback notices, payment admin alerts.
# Format: bare email address.
# Needed: no, but set it live or admin mail has nowhere to go.
# Browser: no, server only.
# Safe: yes.
# Get it: your team inbox.
ADMIN_EMAIL=""

# =====================================================
# Arcjet bot plus shield plus rate limits
# =====================================================
# What: site key for shield, bot detect, token buckets, signup mail check. Built at boot, missing key fails requests.
# Format: starts with ajkey.
# Needed: yes.
# Browser: no, server only.
# Safe: no, it is a site credential, never share.
# Get it: https://console.arcjet.com then create a site and copy the key from SDK install screen.
ARCJET_KEY=""
# What: forces SDK env so Live rules do not block you locally.
# Format: development or production.
# Needed: no. Set development locally.
# Browser: no, server only.
# Safe: yes.
# Get it: no signup, you set it.
ARCJET_ENV="development"

# =====================================================
# Fapshi Cameroon Mobile Money
# =====================================================
# What: service user and key sent as apiuser and apikey headers.
# Format: short opaque user plus opaque secret.
# Needed: yes for payments.
# Browser: no, server only.
# Safe: no for both, keep the key secret in particular.
# Get it: Fapshi dashboard service page. Docs at https://docs.fapshi.com and site at https://www.fapshi.com
FAPSHI_API_USER=""
FAPSHI_API_KEY=""
# What: shared secret compared with inbound Authorization Bearer on payment webhook. Only guard against strangers crediting themselves.
# Format: opaque secret you pick and paste in Fapshi webhook settings.
# Needed: yes for payment reconcile. Empty value fails open so never leave empty live.
# Browser: no, server only.
# Safe: no, never share.
# Get it: you create it, then set the same value in Fapshi dashboard webhook settings for https://yourdomain.com/api/webhooks/fapshi
FAPSHI_WEBHOOK_SECRET=""
# What: picks sandbox host when exactly true, else live host.
# Format: literal true or empty.
# Needed: no. Use true for tests.
# Browser: no, server only.
# Safe: yes.
# Get it: no signup, you set it.
FAPSHI_SANDBOX="true"
# What: explicit base URL override. Prefer setting this so the built in fallback is never load bearing.
# Format: https://sandbox.fapshi.com for tests. Confirm live host in your dashboard before going live.
# Needed: no, but recommended.
# Browser: no, server only.
# Safe: yes, it is a URL.
# Get it: Fapshi dashboard. Sandbox value below is verified in Fapshi OpenAPI servers block.
FAPSHI_BASE_URL="https://sandbox.fapshi.com"

# =====================================================
# Inngest background jobs
# =====================================================
# What: event key for send calls from note processing, quiz gen, Paper 3 eval, metrics, campaigns, mail.
# Format: hex string from dashboard, per env.
# Needed: yes in cloud mode for all jobs. Local dev server needs no key when INNGEST_DEV is 1.
# Browser: no, server only.
# Safe: no, never share.
# Get it: https://app.inngest.com then app keys, Event Keys tab.
INNGEST_EVENT_KEY=""
# What: signing key for the serve endpoint at /api/inngest.
# Format: even length hex. You may generate with openssl rand -hex 32 when self hosting.
# Needed: yes in cloud mode.
# Browser: no, server only.
# Safe: no, never share.
# Get it: https://app.inngest.com then app keys, Signing Key tab.
INNGEST_SIGNING_KEY=""
# What: points SDK at local dev server and skips signature check.
# Format: literal 1 locally, 0 or empty live.
# Needed: no, local only.
# Browser: no, server only.
# Safe: yes.
# Get it: no signup, you set it.
INNGEST_DEV="1"
# What: public origin Inngest uses to reach you when Host guess fails behind tunnel or proxy.
# Format: origin with protocol and port, example https://abcd.ngrok.io
# Needed: no, only with tunnels.
# Browser: no, server only.
# Safe: yes.
# Get it: your tunnel URL.
# INNGEST_SERVE_ORIGIN=""

# =====================================================
# UploadThing file uploads
# =====================================================
# What: single credential for UploadThing v7. Presigned URLs are made on your server so no extra call is needed.
# Format: base64 JSON blob starting with eyJ.
# Needed: yes for uploads.
# Browser: no, server only.
# Safe: no, never share.
# Get it: https://uploadthing.com/dashboard then your app then API Keys then V7 tab, copy Token.
UPLOADTHING_TOKEN=""

# =====================================================
# Sentry error tracking
# =====================================================
# What: DSN for browser plus server plus edge init.
# Format: https URL with project id.
# Needed: no. Empty means Sentry stays idle.
# Browser: yes, DSN ships to browser by design and is safe to expose.
# Safe: yes for DSN, no for auth token below.
# Get it: https://sentry.io/ then project settings.
SENTRY_DSN=""
# What: org plus project slugs for source map uploads in CI.
# Format: short slugs as shown in Sentry URL.
# Needed: no, CI only.
# Browser: no, build only.
# Safe: yes.
# Get it: same Sentry project settings.
SENTRY_ORG=""
SENTRY_PROJECT=""
# What: auth token for source map uploads. Never ships to browser.
# Format: opaque token.
# Needed: no, CI only.
# Browser: no, build only.
# Safe: no, never share.
# Get it: Sentry user settings auth tokens.
SENTRY_AUTH_TOKEN=""

# =====================================================
# Prompt files
# =====================================================
# What: folder for editable prompt markdown with front matter. Read at runtime so edits apply on next request.
# Format: relative path from repo root.
# Needed: no, defaults to prompts.
# Browser: no, server only.
# Safe: yes.
# Get it: no signup, you set it only to point elsewhere.
# PROMPTS_DIR="prompts"
# What: verbose log of prompt name plus version plus model per call.
# Format: literal 1 to log, empty to stay quiet.
# Needed: no, debug only.
# Browser: no, server only.
# Safe: yes.
# Get it: no signup, you set it.
# PROMPTS_DEBUG=""

# =====================================================
# Local docker only
# =====================================================
# What: Postgres user, password, DB for local compose on host port 5435. Must match DATABASE_URL above.
# Format: short strings, no spaces.
# Needed: yes for pnpm db:up locally. Not used live.
# Browser: no, never leaves your machine.
# Safe: no for password, but local only so low risk. Never reuse live secrets here.
# Get it: you pick them. Values below are dev defaults.
POSTGRES_USER="ticlearn"
POSTGRES_PASSWORD="ticlearn_password"
POSTGRES_DB="ticlearn"
# What: pgAdmin login on port 5050. Change from defaults on any shared machine.
# Format: email plus password.
# Needed: no, dev tool only.
# Browser: no, local only.
# Safe: no, and default admin password is weak, so change it or bind to loopback.
# Get it: you pick them.
PGADMIN_DEFAULT_EMAIL="admin@ticlearn.com"
PGADMIN_DEFAULT_PASSWORD="admin"

# =====================================================
# Platform provided, do not set by hand
# =====================================================
# What: build mode set by Next.js. Toggles Prisma logging in lib/prisma.ts.
# Format: development, production, or test. Next.js sets it, do not set it yourself.
# Needed: yes, but provided for you.
# Browser: build only.
# Safe: yes.
# Get it: no signup, the platform sets it.
# NODE_ENV="development"
# What: host name set by Vercel for analytics. No action needed.
# Format: host name without protocol.
# Needed: no, Vercel provides it.
# Browser: build only.
# Safe: yes.
# Get it: no signup, the platform sets it.
# VERCEL_URL=""
# What: flag set by CI runners. Quiets Sentry logs in next.config.ts.
# Format: true on most runners, empty locally.
# Needed: no.
# Browser: build only.
# Safe: yes.
# Get it: no signup, the runner sets it.
# CI=""
# What: runtime branch set by Next.js for edge versus node paths in instrumentation.
# Format: edge or nodejs. Next.js sets it, do not set it yourself.
# Needed: no.
# Browser: no.
# Safe: yes.
# Get it: no signup, the platform sets it.
# NEXT_RUNTIME=""

# =====================================================
# Removed, do not add back
# =====================================================
# OPENAI_API_KEY: removed. No code imports the OpenAI provider. A live key in old .env files should be revoked at the OpenAI dashboard then deleted locally.
# NIM_API_KEY: removed. NVIDIA path was part of the retired chain, zero references remain.
# UPLOADTHING_APP_ID: removed. V7 folds app id into UPLOADTHING_TOKEN.
# NEXT_PUBLIC_POSTHOG_KEY plus NEXT_PUBLIC_POSTHOG_HOST: removed. PostHog is not installed and code never reads them. They shipped in browser bundle as dead weight.
