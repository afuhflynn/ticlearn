# ===========================================
# Database - PostgreSQL
# ===========================================
# Local: Docker PostgreSQL on port 5435
DATABASE_URL="postgresql://ticlearn:ticlearn_password@localhost:5435/ticlearn?schema=public"
# Production (Neon):
# DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# Docker Compose variables (for local development)
POSTGRES_USER="ticlearn"
POSTGRES_PASSWORD="ticlearn_password"
POSTGRES_DB="ticlearn"
PGADMIN_DEFAULT_EMAIL="admin@ticlearn.com"
PGADMIN_DEFAULT_PASSWORD="admin"

# ===========================================
# App Configuration
# ===========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_SECRET="your-better-auth-secret-here"
BETTER_AUTH_URL="http://localhost:3000"

# ===========================================
# OAuth - Google (Optional)
# ===========================================
# Setup: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ===========================================
# AI - Google Gemini (Primary AI Provider)
# ===========================================
# Get your API key: https://aistudio.google.com/apikey
# Gemini 2.5 Flash is the primary AI model for all operations
GOOGLE_GENERATIVE_AI_API_KEY="your-google-ai-api-key"

# ===========================================
# AI - OpenAI (Optional Fallback)
# ===========================================
# Only needed if Gemini is unavailable:
OPENAI_API_KEY="sk-proj-your-openai-api-key"

# ===========================================
# AI - NVIDIA NIM (Optional Fallback)
# ===========================================
# Sign up: https://build.nvidia.com/explore/
NIM_API_KEY="nvapi-your-nim-api-key"

# ===========================================
# Storage - UploadThing (Optional)
# ===========================================
# Setup: https://uploadthing.com/dashboard
UPLOADTHING_TOKEN="your-uploadthing-token"
UPLOADTHING_APP_ID="your-uploadthing-app-id"

# ===========================================
# Payments - Fapshi (Cameroon Mobile Money)
# ===========================================
# Setup: https://fapshi.com/developer
FAPSHI_API_USER="your-fapshi-api-user"
FAPSHI_API_KEY="your-fapshi-api-key"
FAPSHI_WEBHOOK_SECRET="your-fapshi-webhook-secret"
FAPSHI_SANDBOX="true"
FAPSHI_BASE_URL="https://sandbox.fapshi.com"

# ===========================================
# Email - SMTP (Optional)
# ===========================================
# For Gmail: Use App Password (enable 2FA first)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
ADMIN_EMAIL="no-reply@yourdomain.com"
FROM_EMAIL="Your App <no-reply@yourdomain.com>"

# ===========================================
# Security - Arcjet (Optional)
# ===========================================
# Setup: https://app.arcjet.com
ARCJET_KEY="ajkey_your-arcjet-key"

# ===========================================
# Background Jobs - Inngest (Optional)
# ===========================================
# Setup: https://www.inngest.com/
INNGEST_EVENT_KEY="your-event-key"
INNGEST_SIGNING_KEY="your-signing-key"
INNGEST_DEV=1

# ===========================================
# Error Tracking - Sentry (Optional)
# ===========================================
# Setup: https://sentry.io/
# Get DSN from Sentry project settings
SENTRY_DSN=""
# Auth token for source map uploads (CI/CD)
SENTRY_AUTH_TOKEN=""
# Organization and project slugs for source map uploads
SENTRY_ORG=""
SENTRY_PROJECT=""

# ===========================================
# Web Search - Tavily (Optional)
# ===========================================
# Setup: https://tavily.com/
TAVILY_API_KEY="tvly-your-tavily-api-key"
